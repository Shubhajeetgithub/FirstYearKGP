---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogHeader from "../../components/BlogHeader.astro";
import { SITE } from "../../config/site";

const fields: [name: string, required: string, notes: string][] = [
  ["title", "yes", "The post title."],
  ["description", "yes", "One or two sentences, at most 160 characters. Used in search results and link previews."],
  ["pubDate", "yes", "Publication date, YYYY-MM-DD."],
  ["author", "yes", "Your author id: the file name of your entry in authors/, without .json. Use a list for co-authors."],
  ["tags", "no", "Lowercase topics, e.g. [signals, fourier]. Spaces become hyphens."],
  ["subject", "no", "Course code, e.g. AI20203."],
  ["updatedDate", "no", "Date of a significant update."],
  ["cover", "no", "Cover image file name, next to the post."],
  ["coverAlt", "no", "Text description of the cover for screen readers."],
  ["draft", "no", "true keeps the post off the live site."],
];
const repo = SITE.blogRepoUrl;
const branch = SITE.blogBranch;
---

<BaseLayout
  title={`Write for the blog — ${SITE.name}`}
  description="How students of the AI Batch 2024 can write posts for the blog: the editor, the frontmatter fields, maths, images and review."
>
  <BlogHeader title="Write for the blog" subtitle="Explainers, exam tips and notes from the batch, for the batch." />

  <div class="prose prose-invert prose-lg max-w-3xl mx-auto prose-post">
    <h2 id="who-can-write">Who can write</h2>
    <p>
      Posts live in their own repository,
      <a href={repo} target="_blank" rel="noopener noreferrer">{SITE.blogRepo}</a>, separate from the website's code. Anyone with
      <strong>write access</strong> to it can publish: ask a maintainer to add you as a collaborator. Every post is a commit, so there
      is full history and anything can be rolled back.
    </p>
    <p>
      <strong>First time?</strong> Add yourself as an author before writing your first post: in the editor, open
      <em>Authors → New</em> (or add a JSON file to <code>authors/</code>). Your author id is the file name, for example
      <code>firstname-lastname</code>.
    </p>

    <h2 id="option-a-the-editor">Option A: the online editor</h2>
    <ol>
      <li>Go to <a href="/admin">/admin</a> and sign in with GitHub.</li>
      <li>Open <em>Blog posts → New</em>, fill in the fields and write the post in Markdown. The preview on the right shows it as it will look on the site, maths included.</li>
      <li>Upload images with the image button in the editor; they are stored next to the post.</li>
      <li>Leave <em>Draft</em> on while you work. Turn it off and save to publish.</li>
      <li>Saving commits to the blog repository. An automatic check builds the site with your post; if it passes, the post appears within a couple of minutes. If it fails, nothing changes on the site and the error is shown under the repository's <em>Actions</em> tab.</li>
    </ol>
    <p>
      <strong>Can't sign in?</strong> Use <em>Sign In Using Access Token</em> on the login screen. Create a
      <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">fine-grained personal access token</a>
      for the blog repository only, with <em>Contents: Read and write</em> permission, and paste it in. The token stays in your browser.
    </p>

    <h2 id="option-b-files-and-a-pull-request">Option B: files and a pull request</h2>
    <ol>
      <li>Clone <a href={repo} target="_blank" rel="noopener noreferrer">{SITE.blogRepo}</a>.</li>
      <li>Copy <a href={`${repo}/blob/${branch}/TEMPLATE.md`} target="_blank" rel="noopener noreferrer">TEMPLATE.md</a> to <code>posts/your-post-slug/index.md</code>. The folder name becomes the URL, <code>/blog/your-post-slug</code>.</li>
      <li>Put any images in the same folder.</li>
      <li>Open a pull request. The check builds the site with your post and reports any problem.</li>
    </ol>
    <p>
      To preview locally, clone the website next to the blog repository and run
      <code>BLOG_CONTENT_DIR=../FirstYearKGP-blog npm run dev</code> in the website folder, then open
      <code>http://localhost:4321/blog</code>. You can also open <a href="/admin">/admin</a> in Chrome or Edge, choose
      <em>Work with Local Repository</em> and select your clone of the blog repository.
    </p>

    <h2 id="frontmatter">Frontmatter fields</h2>
    <div class="not-prose overflow-x-auto rounded-xl border border-white/10">
      <table class="w-full text-left text-sm">
        <thead class="bg-white/5 text-slate-200">
          <tr><th scope="col" class="px-4 py-3">Field</th><th scope="col" class="px-4 py-3">Required</th><th scope="col" class="px-4 py-3">Notes</th></tr>
        </thead>
        <tbody class="divide-y divide-white/5 text-slate-300">
          {fields.map(([name, required, notes]) => (
            <tr>
              <td class="px-4 py-3 font-mono text-indigo-200">{name}</td>
              <td class="px-4 py-3">{required}</td>
              <td class="px-4 py-3">{notes}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 id="maths">Maths</h2>
    <p>Write LaTeX between dollar signs. There's nothing to switch on: posts with maths load the maths styles automatically.</p>
    <ul>
      <li>Inline: <code>$e^{"{"}j\pi{"}"} + 1 = 0$</code></li>
      <li>Display: <code>$$</code> on its own line, the formula, then <code>$$</code> again.</li>
      <li>A literal dollar sign is <code>\$</code>.</li>
    </ul>
    <p>
      Rendering uses KaTeX, which supports most of what you would write in a LaTeX report. Long display equations scroll sideways on phones.
    </p>

    <h2 id="images">Images</h2>
    <ul>
      <li>Keep each image under <strong>300 KB</strong>. Prefer WebP, or PNG for diagrams. The site converts and resizes them anyway, but smaller files keep the repository fast.</li>
      <li>Put images next to the post and link them by file name: <code>![What the image shows](figure.webp)</code>.</li>
      <li>Always describe the image in the alt text.</li>
    </ul>

    <h2 id="review">Review and guidelines</h2>
    <ul>
      <li>Write for a classmate who missed the lecture: explain, don't just list formulas.</li>
      <li>Cite sources and link to the original material. Don't upload copyrighted books or papers.</li>
      <li>Maintainers are notified about new posts and may suggest edits. Readers can comment and react at the bottom of each post.</li>
    </ul>
  </div>
</BaseLayout>
