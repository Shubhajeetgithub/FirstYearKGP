---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
---

<BaseLayout title={`Page not found — ${SITE.name}`} description="This page does not exist." noindex>
  <div class="flex flex-col items-center justify-center text-center min-h-[50vh] gap-6">
    <p class="font-mono text-sm text-indigo-300 bg-indigo-500/10 border border-indigo-500/20 rounded-full px-3 py-1">404</p>
    <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Page not found</h1>
    <p class="text-slate-400 max-w-md">
      The page you were looking for has moved or never existed. Try one of these instead:
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3">
      <a href="/" class="px-6 py-2.5 rounded-full bg-white text-black font-semibold hover:bg-slate-200 transition-colors">Home</a>
      <a href="/resources" class="px-6 py-2.5 rounded-full bg-white/5 border border-white/10 text-white font-semibold hover:bg-white/10 transition-colors">Resources</a>
      <a href="/blog" class="px-6 py-2.5 rounded-full bg-white/5 border border-white/10 text-white font-semibold hover:bg-white/10 transition-colors">Blog</a>
    </div>
  </div>
</BaseLayout>
