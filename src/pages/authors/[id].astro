---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Avatar from "../../components/Avatar.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, postsByAuthor } from "../../lib/blog";
import type { Author, Post } from "../../lib/blog";
import { SITE } from "../../config/site";

export const getStaticPaths = (async () => {
  const [authors, posts] = await Promise.all([getCollection("authors"), getPosts()]);
  return authors.map((author) => ({ params: { id: author.id }, props: { author, posts: postsByAuthor(posts, author.id) } }));
}) satisfies GetStaticPaths;

interface Props {
  author: Author;
  posts: Post[];
}

const { author, posts } = Astro.props;
const { name, github, role, bio } = author.data;
---

<BaseLayout
  title={`${name} — ${SITE.name} Blog`}
  description={bio ?? `Posts by ${name} on the AI Batch 2024 student blog at IIT Kharagpur.`}
>
  <div class="flex flex-col items-center text-center mb-12">
    <Avatar author={author.data} size={112} class="border-2 border-indigo-500/40 shadow-lg" />
    <h1 class="mt-5 text-4xl font-bold text-white tracking-tight">{name}</h1>
    {role && <p class="mt-1 text-indigo-300/80">{role}</p>}
    {bio && <p class="mt-4 max-w-xl text-slate-400 leading-relaxed">{bio}</p>}
    <a href={`https://github.com/${github}`} target="_blank" rel="noopener noreferrer" class="mt-3 text-sm text-slate-400 hover:text-indigo-300 transition-colors">
      @{github} on GitHub
    </a>
  </div>

  <h2 class="text-sm font-bold tracking-widest uppercase mb-6 text-slate-400 text-center">
    {posts.length} {posts.length === 1 ? "post" : "posts"}
  </h2>
  {
    posts.length ? (
      <div class="grid gap-6 md:grid-cols-2 max-w-5xl mx-auto w-full">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="text-center text-slate-400">No posts yet.</p>
    )
  }
</BaseLayout>
