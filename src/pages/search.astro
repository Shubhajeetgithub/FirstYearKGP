---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteSearch from "../components/SiteSearch";
import { SITE } from "../config/site";
---

<BaseLayout title={`Search — ${SITE.name}`} description="Search the AI Batch 2024 blog and course resources." noindex>
  <div class="flex flex-col items-center mb-8 space-y-3 text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Search</h1>
    <p class="text-slate-400">Blog posts and course resources. Press <kbd class="px-1.5 py-0.5 rounded border border-white/20 bg-white/5 text-xs font-mono text-slate-300">/</kbd> anywhere to search.</p>
  </div>
  <SiteSearch client:load />
</BaseLayout>
