# Google Sheet published as CSV (File → Share → Publish to web → CSV).
# Read at build time to render the resources pages. Required: the build fails without it.
SHEET_CSV_URL=""
# The same URL, used by the browser to pick up sheet edits made after the last build.
VITE_SHEET_CSV_URL=""
# Optional: "true" loads Vercel Web Analytics (enable it in the Vercel dashboard first).
PUBLIC_VERCEL_ANALYTICS=""
# Optional: build the blog from a local clone of the blog repository instead of downloading it.
# BLOG_CONTENT_DIR="../FirstYearKGP-blog"
# Optional: another blog repository (owner/name), branch, or a read token for a private one.
# BLOG_CONTENT_REPO=""
# BLOG_CONTENT_REF=""
# BLOG_CONTENT_TOKEN=""
